+// Velocidad continua para un eje (control en tiempo real, ciclo a ciclo de
+// comunicacion con el RPi -- NO es un lazo dentro del ESP32, es el RPi
+// reenviando SET_VEL a su propio ritmo). steps_per_sec == 0 pide parar ese
+// eje. Devuelve 0 si se rechaza (eje ocupado con un movimiento finito,
+// direccion invalida, o limite de carrera en esa direccion).
+int axis_set_velocity(Axis &ax, int direction, int steps_per_sec){
+  if (steps_per_sec == 0){
+    portENTER_CRITICAL(&axes_mux);
+    if (ax.continuous_mode) axis_stop(ax);
+    portEXIT_CRITICAL(&axes_mux);
+    return 1;
+  }
+
+  if (steps_per_sec < 0) return 0;
+
+  // Ocupado con un movimiento finito (MANUAL/GOTO/trayectoria)
+  if (!ax.continuous_mode && ax.steps_remaining != 0) return 0;
+
+  if (direction != 0 && direction != 1) return 0;
+
+  if (!(direction == ax.positive_dir) && button_pressed(ax.limit_min_pin)) return 0;
+  if ((direction == ax.positive_dir) && button_pressed(ax.limit_max_pin)) return 0;
+
+  int nuevo_sign = (direction == ax.positive_dir) ? 1 : -1;
+  int step_period_us = 1000000 / steps_per_sec;
+
+  // Cambio de sentido con el eje ya en movimiento: NUNCA cambiar DIR mientras
+  // el driver puede estar a mitad de un pulso. Se para primero (axis_stop ya
+  // espera a STEP bajo antes de desarmar el timer) y se rearma en el
+  // siguiente SET_VEL -- este ciclo de control pierde como maximo un periodo
+  // de control (~10-20 ms), no es instantaneo pero es seguro para el driver.
+  if (ax.continuous_mode && ax.motion_sign != nuevo_sign){
+    portENTER_CRITICAL(&axes_mux);
+    axis_stop(ax);
+    portEXIT_CRITICAL(&axes_mux);
+    return 1;  // el RPi debe reintentar en el siguiente ciclo con el eje ya parado
+  }
+
+  digitalWrite(ax.dir_pin, direction);
+  if (!ax.continuous_mode) delayMicroseconds(ax.dir_setup_us);  // primer arranque: igual que axis_move_steps
+
+  portENTER_CRITICAL(&axes_mux);
+  ax.motion_sign = nuevo_sign;
+  ax.last_vel_update_us = (uint32_t) esp_timer_get_time();
+
+  if (!ax.continuous_mode){
+    ax.continuous_mode = 1;
+    timerWrite(ax.timer, 0);
+    timerAlarmWrite(ax.timer, step_period_us / 2, true);
+    timerAlarmEnable(ax.timer);
+    timerStart(ax.timer);
+  }
+  else{
+    timerAlarmWrite(ax.timer, step_period_us / 2, true);  // solo cambia el periodo, no la fase
+  }
+  portEXIT_CRITICAL(&axes_mux);
+  return 1;
+}
