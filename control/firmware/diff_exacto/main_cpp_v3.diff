+// Comando SET_VEL:eje:pasos_por_seg_con_signo -- control en tiempo real.
+// El RPi reenvia este comando a su propio ritmo (ej. cada 10-20 ms) con la
+// velocidad que calcule su lazo de realimentacion; el ESP32 no corre ningun
+// lazo, solo aplica la velocidad pedida al eje indicado. pasos_por_seg = 0
+// detiene ese eje. El signo da la direccion (positivo = ax.positive_dir).
+void handle_velocity_command(Packet &rxPacket, Packet &txPacket){
+  if (strcmp(rxPacket.command, SET_VEL) != 0) return;
+
+  int eje = rxPacket.parameters[0];
+  int v = rxPacket.parameters[1];
+  int mag = abs(v);
+  int ok = 0;
+
+  // No se mezcla con una trayectoria activa (misma regla que MANUAL/GOTO)
+  if (Traj_state != TRAJ_IDLE){
+    strncpy(txPacket.command, BUSY, MAX_COMMAND_LENGTH);
+    txPacket.parameter_count = 0;
+    return;
+  }
+
+  if (eje == 0) ok = axis_set_velocity(axis_x, (v >= 0) ? axis_x.positive_dir : !axis_x.positive_dir, mag);
+  else if (eje == 1) ok = axis_set_velocity(axis_y, (v >= 0) ? axis_y.positive_dir : !axis_y.positive_dir, mag);
+  else if (eje == 2) ok = axis_set_velocity(axis_k, (v >= 0) ? axis_k.positive_dir : !axis_k.positive_dir, mag);
+
+  strncpy(txPacket.command, ok ? OK : BUSY, MAX_COMMAND_LENGTH);
+  txPacket.parameter_count = 0;
+}
